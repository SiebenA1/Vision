# DeepSeek API key read by the v2 backend; never sent to the browser.
# Keep this file out of git. Leave empty for manual CAD/CAE without AI.
DEEPSEEK_API_KEY=

# v2 also reads DEEPSEEK_API_KEY from its process environment or root .env.
# New terminals inherit updated Windows user environment variables.
# VISION_DEEPSEEK_MODEL=deepseek-flash

# Managed v2 core started by npm run dev / npm run preview.
# VISION_CORE_PORT=8112
# VISION_CORE_WORKSPACE=.vision-workspace
# Set a URL only for an independently managed core; disables automatic startup.
# VISION_CORE_URL=http://127.0.0.1:8112
