# DeepSeek API key used by the local Vite gateway.
# Keep this file out of git. The key never reaches the browser when set here.
DEEPSEEK_API_KEY=

# Optional OpenAI-compatible DeepSeek endpoint override.
# This override applies to the legacy gateway only; v2 uses the official URL.
DEEPSEEK_API_BASE=https://api.deepseek.com

# v2 also reads DEEPSEEK_API_KEY from its process environment or root .env.
# New terminals inherit updated Windows user environment variables.
# VISION_DEEPSEEK_MODEL=deepseek-flash
