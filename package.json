{
  "name": "vision-engineering-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VISION — an AI-native CAD/CAE engineering studio",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:measurements": ".python312\\python.exe tests/native_cad_inspection.py",
    "test:agent-memory": ".python313\\python.exe tests/test_agent_memory.py",
    "test:backend": "node scripts/test_dev_backend.mjs",
    "test:core": ".python313\\python.exe -m unittest discover -s tests -p test_workspace_v2.py",
    "test:tasks": ".python313\\python.exe -m unittest discover -s tests -p test_tasks_v2.py",
    "test:model-tasks": ".python313\\python.exe -m unittest discover -s tests -p test_model_tasks_v2.py",
    "test:core-ui": "node scripts/core-ui-test.mjs",
    "backend": "python scripts/run_backend.py",
    "core": ".python313\\python.exe -m backend.vision",
    "test:python": ".python313\\python.exe -m unittest discover -s tests -p test_*.py",
    "test:native": ".python313\\python.exe scripts/test_native_engineering.py"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.9",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.8"
  }
}
